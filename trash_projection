        #define FOV_RAD (PI/3.f)
#define ANG_STEP_RAD (FOV_RAD/8.f)
float cos_az[8+1];
float sin_az[8+1];
float cos_el[8+1];
float sin_el[8+1];
void precompute_trig() {
    float azimuth = -PI/6.f;
    float elevation = PI/2;
    
    for (int n = 0; n < 8+1; n++) {
        cos_az[n] = cosf(azimuth);
        sin_az[n] = sinf(azimuth);
        cos_el[n] = cosf(elevation);
        sin_el[n] = sinf(elevation);

        azimuth += ANG_STEP_RAD;
        elevation -= ANG_STEP_RAD;
    }
}

